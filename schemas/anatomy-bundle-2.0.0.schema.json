{
  "$defs": {
    "AnatomyLabel": {
      "additionalProperties": false,
      "properties": {
        "metadata": {"additionalProperties": true, "title": "Metadata", "type": "object"},
        "name": {"title": "Name", "type": "string"},
        "ontology_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Ontology Id"},
        "structure": {"title": "Structure", "type": "string"},
        "value": {"title": "Value", "type": "integer"}
      },
      "required": ["name","value","structure"],
      "title": "AnatomyLabel",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Acquisition Id"},
        "artifact_id": {"title": "Artifact Id", "type": "string"},
        "derived_from": {"items": {"type": "string"}, "title": "Derived From", "type": "array"},
        "frame_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Frame Id"},
        "kind": {
          "enum": ["dicom_series","nifti_image","segmentation","contour_set","guidepoint_set","landmark_set","surface_mesh","volume_mesh","chamber_tags","valve_tags","coordinate_field","fiber_field","sheet_field","scar_map","motion_field","registration","qc_report","model_fit","report","other"],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Media Type"},
        "metadata": {"additionalProperties": true, "title": "Metadata", "type": "object"},
        "producer": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Producer"},
        "sha256": {"anyOf": [{"maxLength": 64, "minLength": 64, "type": "string"}, {"type": "null"}], "default": null, "title": "Sha256"},
        "size_bytes": {"anyOf": [{"minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Size Bytes"},
        "study_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Study Id"},
        "subject_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Subject Id"},
        "uri": {"title": "Uri", "type": "string"}
      },
      "required": ["artifact_id","kind","uri"],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "affine_to_parent": {"anyOf": [{"items": {"items": {"type": "number"}, "type": "array"}, "type": "array"}, {"type": "null"}], "default": null, "title": "Affine To Parent"},
        "convention": {"enum": ["DICOM_LPS","NIFTI_RAS","MODEL","UVC","UAC","OTHER"], "title": "Convention", "type": "string"},
        "description": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Description"},
        "frame_id": {"title": "Frame Id", "type": "string"},
        "parent_frame_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Parent Frame Id"},
        "units": {"default": "mm", "title": "Units", "type": "string"}
      },
      "required": ["frame_id","convention"],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "GeometryQC": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Artifact Id"},
        "checks": {"additionalProperties": {"type": "boolean"}, "title": "Checks", "type": "object"},
        "errors": {"items": {"type": "string"}, "title": "Errors", "type": "array"},
        "metrics": {
          "additionalProperties": {"anyOf": [{"type": "number"},{"type": "integer"},{"type": "boolean"},{"type": "string"}]},
          "title": "Metrics",
          "type": "object"
        },
        "passed": {"title": "Passed", "type": "boolean"},
        "warnings": {"items": {"type": "string"}, "title": "Warnings", "type": "array"}
      },
      "required": ["passed"],
      "title": "GeometryQC",
      "type": "object"
    },
    "RegistrationRef": {
      "additionalProperties": false,
      "properties": {
        "matrix": {"anyOf": [{"items": {"items": {"type": "number"}, "type": "array"}, "type": "array"}, {"type": "null"}], "default": null, "title": "Matrix"},
        "method": {"title": "Method", "type": "string"},
        "quality_metric": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null, "title": "Quality Metric"},
        "quality_metric_name": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Quality Metric Name"},
        "registration_id": {"title": "Registration Id", "type": "string"},
        "source_frame": {"title": "Source Frame", "type": "string"},
        "target_frame": {"title": "Target Frame", "type": "string"},
        "transform": {"anyOf": [{"$ref": "#/$defs/ArtifactRef"}, {"type": "null"}], "default": null},
        "uncertainty": {"additionalProperties": true, "title": "Uncertainty", "type": "object"}
      },
      "required": ["registration_id","source_frame","target_frame","method"],
      "title": "RegistrationRef",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "backend": {"title": "Backend", "type": "string"},
        "duration_seconds": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Duration Seconds"},
        "errors": {"items": {"type": "string"}, "title": "Errors", "type": "array"},
        "fingerprint": {"title": "Fingerprint", "type": "string"},
        "finished_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}], "default": null, "title": "Finished At"},
        "input_artifact_ids": {"items": {"type": "string"}, "title": "Input Artifact Ids", "type": "array"},
        "output_artifact_ids": {"items": {"type": "string"}, "title": "Output Artifact Ids", "type": "array"},
        "parameters": {"additionalProperties": true, "title": "Parameters", "type": "object"},
        "stage": {"enum": ["ingest","view_selection","phase_harmonization","segmentation","contours","surface_fit","surface_mesh","volume_mesh","coordinates","microstructure","scar","registration","qc","export"], "title": "Stage", "type": "string"},
        "started_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}], "default": null, "title": "Started At"},
        "status": {"enum": ["pending","running","ok","skipped","error"], "title": "Status", "type": "string"},
        "warnings": {"items": {"type": "string"}, "title": "Warnings", "type": "array"}
      },
      "required": ["stage","backend","status","fingerprint"],
      "title": "StageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition_id": {"title": "Acquisition Id", "type": "string"},
    "artifacts": {"items": {"$ref": "#/$defs/ArtifactRef"}, "title": "Artifacts", "type": "array"},
    "bundle_fingerprint": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Bundle Fingerprint"},
    "contract_version": {"default": "2.0.0", "title": "Contract Version", "type": "string"},
    "frames": {"items": {"$ref": "#/$defs/CoordinateFrame"}, "title": "Frames", "type": "array"},
    "labels": {"items": {"$ref": "#/$defs/AnatomyLabel"}, "title": "Labels", "type": "array"},
    "provenance": {"additionalProperties": true, "title": "Provenance", "type": "object"},
    "qc": {"anyOf": [{"$ref": "#/$defs/GeometryQC"}, {"type": "null"}], "default": null},
    "registrations": {"items": {"$ref": "#/$defs/RegistrationRef"}, "title": "Registrations", "type": "array"},
    "stages": {"items": {"$ref": "#/$defs/StageRecord"}, "title": "Stages", "type": "array"},
    "study_id": {"title": "Study Id", "type": "string"},
    "subject_id": {"title": "Subject Id", "type": "string"}
  },
  "required": ["subject_id","study_id","acquisition_id"],
  "title": "AnatomyBundle",
  "type": "object"
}
